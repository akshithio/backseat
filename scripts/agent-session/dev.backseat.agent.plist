<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>dev.backseat.agent</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/Shared/backseat/backseat</string>
    <string>listen</string>
    <string>/Users/Shared/backseat/agent.sock</string>
    <string>--allow-uid</string>
    <string>__ALLOW_UID__</string>
  </array>
  <key>LimitLoadToSessionType</key><string>Aqua</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardErrorPath</key><string>/tmp/backseat-agent.log</string>
</dict>
</plist>
